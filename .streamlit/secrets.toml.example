# .streamlit/secrets.toml — LOCAL ONLY. Do NOT commit this file.
# On Streamlit Cloud, set these in the app's Secrets manager (Settings → Secrets).

# Initial admin account — auto-created on first boot if no admin exists
[admin]
username = "admin"
password = "your-strong-password-here"

# ScraperAPI key — required for Amazon scraping on Streamlit Cloud (AWS IPs are blocked by Amazon)
# Free tier: https://www.scraperapi.com  (1,000 requests/month, no credit card needed)
SCRAPERAPI_KEY = "your_scraperapi_key_here"
